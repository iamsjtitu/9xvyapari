{
  "name": "9x-vyapari",
  "productName": "9x Vyapari",
  "version": "1.0.0",
  "description": "9x Vyapari – Galla / Kaccha Arhat Hisab Kitab (offline desktop)",
  "main": "main.js",
  "author": "9x.design <7587922222>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:publish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ninex.vyapari",
    "productName": "9x Vyapari",
    "copyright": "© 2026 9x Vyapari. Design and Developed by 9x.design · Contact: 7587922222",
    "artifactName": "9x-Vyapari-${version}-win-portable-folder.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "chooser-preload.js",
      "splash.html",
      "chooser.html",
      "lib/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/backend", "to": "backend" },
      { "from": "resources/mongodb", "to": "mongodb" },
      { "from": "resources/frontend", "to": "frontend" },
      { "from": "update-config.json", "to": "update-config.json" }
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "9x-Vyapari-Portable-${version}.${ext}",
      "unpackDirName": "9xVyapari",
      "splashImage": "build/portable-splash.bmp"
    },
    "nsis": {
      "artifactName": "9x-Vyapari-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "9x Vyapari",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
